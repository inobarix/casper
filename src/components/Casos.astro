---
// Casos de uso / segmentos objetivo.
const casos = [
  {
    titulo: 'Salas de reunión de vidrio',
    texto: 'Presentaciones y videollamadas con información estratégica, protegidas de miradas en pasillos comunes.',
    icon: 'meeting',
  },
  {
    titulo: 'Bancos y fintech',
    texto: 'Puestos operativos y mesas de dinero con datos financieros y de clientes a resguardo visual.',
    icon: 'bank',
  },
  {
    titulo: 'Estudios jurídicos',
    texto: 'Información de causas y clientes protegida en oficinas y salas con paredes vidriadas.',
    icon: 'legal',
  },
  {
    titulo: 'I+D y seguridad de la información',
    texto: 'Áreas de desarrollo y equipos de InfoSec que manejan propiedad intelectual y datos críticos.',
    icon: 'lab',
  },
];

const icons: Record<string, string> = {
  meeting:
    '<rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M3 10h18M8 6V4M16 6V4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  bank:
    '<path d="M4 10l8-5 8 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M5 10v8M10 10v8M14 10v8M19 10v8M3 20h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  legal:
    '<path d="M12 3v18M6 7l-3 6a3 3 0 0 0 6 0l-3-6zM18 7l-3 6a3 3 0 0 0 6 0l-3-6z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M4 20h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  lab:
    '<path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 15h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
};
---

<section id="casos" class="casos section">
  <div class="container">
    <div class="section-header reveal">
      <p class="eyebrow">Para quién es</p>
      <h2 class="section-title">Diseñado para entornos donde la confidencialidad es crítica</h2>
      <p class="section-lead">
        Cualquier organización con vidrios en zonas de circulación o atención al público
        es un punto de exposición. Estos son los perfiles donde el impacto es mayor.
      </p>
    </div>

    <ul class="casos__grid">
      {casos.map((c) => (
        <li class="caso-card reveal">
          <span class="caso-card__icon" set:html={`<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">${icons[c.icon]}</svg>`} />
          <div>
            <h3 class="caso-card__title">{c.titulo}</h3>
            <p class="caso-card__text">{c.texto}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .casos__grid {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: 1fr;
  }

  .caso-card {
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
    padding: var(--sp-3);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-borde);
  }

  .caso-card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-primario);
    color: var(--color-acento);
  }

  .caso-card__icon svg {
    width: 22px;
    height: 22px;
  }

  .caso-card__title {
    font-size: var(--fs-base);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .caso-card__text {
    color: var(--color-secundario);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
  }

  @media (min-width: 620px) {
    .casos__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
