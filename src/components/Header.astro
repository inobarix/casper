---
// Header / Nav sticky. [NOMBRE_MARCA]: reemplazar por el nombre real de la marca.
const NOMBRE_MARCA = '[NOMBRE_MARCA]';

const navLinks = [
  { href: '#que-es', label: 'Qué es' },
  { href: '#beneficios', label: 'Beneficios' },
  { href: '#casos', label: 'Casos' },
  { href: '#contacto', label: 'Contacto' },
];
---

<header class="header" id="inicio">
  <div class="container header__inner">
    <a href="#inicio" class="header__logo" aria-label={`${NOMBRE_MARCA} — inicio`}>
      {NOMBRE_MARCA}
    </a>

    <button
      class="header__toggle"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <span class="sr-only">Abrir menú de navegación</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>

    <nav class="header__nav" id="menu-principal" aria-label="Navegación principal">
      <ul class="header__links">
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
      <a href="#contacto" class="btn btn-primary header__cta">
        Solicitar demo
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(11, 18, 32, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(248, 250, 252, 0.08);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: var(--sp-3);
  }

  .header__logo {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--color-texto-invertido);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid rgba(248, 250, 252, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-texto-invertido);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .header__links a {
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-texto-invertido);
    opacity: 0.85;
    transition: opacity var(--transition-base);
    padding-block: var(--sp-1);
  }

  .header__links a:hover {
    opacity: 1;
  }

  .header__cta {
    min-height: 44px;
    padding: 0.65rem 1.25rem;
  }

  /* Mobile: menú colapsado en overlay */
  @media (max-width: 860px) {
    .header__toggle {
      display: inline-flex;
    }

    .header__nav {
      position: fixed;
      inset: 72px 0 0 0;
      background: var(--color-primario);
      flex-direction: column;
      align-items: stretch;
      padding: var(--sp-4) var(--container-pad);
      gap: var(--sp-4);
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-base), transform var(--transition-base);
      overflow-y: auto;
    }

    .header__nav.is-open {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .header__links {
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-1);
    }

    .header__links a {
      display: block;
      padding: var(--sp-2) 0;
      font-size: var(--fs-md);
      border-bottom: 1px solid rgba(248, 250, 252, 0.08);
    }

    .header__cta {
      width: 100%;
    }
  }

  @media (min-width: 861px) {
    .header__toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-principal');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
