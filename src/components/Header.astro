---
// Header / Nav sticky.
import Logo from './Logo.astro';
import { GUIAS } from '../data/guias';

const NOMBRE_MARCA = 'Invision';

const linksAntes = [
  { href: '/#que-es', label: 'Qué es' },
  { href: '/#beneficios', label: 'Beneficios' },
  { href: '/#casos', label: 'Casos' },
];
const linksDespues = [{ href: '/#contacto', label: 'Contacto' }];
---

<header class="header" id="inicio">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label={`${NOMBRE_MARCA} — inicio`}>
      <Logo />
    </a>

    <button
      class="header__toggle"
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <span class="sr-only">Abrir menú de navegación</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>

    <nav class="header__nav" id="menu-principal" aria-label="Navegación principal">
      <ul class="header__links">
        {linksAntes.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
        <li class="header__dropdown">
          <button
            class="header__dropdown-toggle"
            id="guias-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="guias-submenu"
          >
            Guías
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </svg>
          </button>
          <ul class="header__submenu" id="guias-submenu">
            {GUIAS.map((g) => (
              <li>
                <a href={g.path}>{g.titulo}</a>
              </li>
            ))}
          </ul>
        </li>
        {linksDespues.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
      <a href="/#contacto" class="btn btn-primary header__cta">
        Solicitar demo
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(11, 18, 32, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(248, 250, 252, 0.08);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: var(--sp-3);
  }

  .header__logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--color-texto-invertido);
    text-decoration: none;
  }

  .header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid rgba(248, 250, 252, 0.2);
    border-radius: var(--radius-sm);
    color: var(--color-texto-invertido);
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .header__links a {
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-texto-invertido);
    opacity: 0.85;
    transition: opacity var(--transition-base);
    padding-block: var(--sp-1);
  }

  .header__links a:hover {
    opacity: 1;
  }

  .header__cta {
    min-height: 44px;
    padding: 0.65rem 1.25rem;
  }

  /* Submenú "Guías": se abre con clic (JS agrega .is-open) y, en desktop
     con mouse, también al pasar por encima. */
  .header__dropdown {
    position: relative;
  }

  .header__dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: transparent;
    border: 0;
    padding: var(--sp-1) 0;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-texto-invertido);
    opacity: 0.85;
    transition: opacity var(--transition-base);
  }

  .header__dropdown-toggle:hover,
  .header__dropdown.is-open .header__dropdown-toggle {
    opacity: 1;
  }

  .header__dropdown-toggle svg {
    transition: transform var(--transition-base);
  }

  .header__dropdown.is-open .header__dropdown-toggle svg {
    transform: rotate(180deg);
  }

  .header__submenu {
    display: none;
  }

  .header__dropdown.is-open .header__submenu {
    display: block;
  }

  @media (min-width: 861px) {
    .header__submenu {
      position: absolute;
      top: 100%;
      left: 50%;
      transform: translateX(-50%);
      min-width: 300px;
      margin-top: var(--sp-1);
      padding: var(--sp-1);
      background: var(--color-primario-800);
      border: 1px solid rgba(248, 250, 252, 0.12);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
    }

    /* Puente invisible para que el hover no se corte entre botón y panel */
    .header__submenu::before {
      content: '';
      position: absolute;
      inset: calc(-1 * var(--sp-1)) 0 auto;
      height: var(--sp-1);
    }

    .header__submenu a {
      display: block;
      padding: 0.6rem var(--sp-2);
      border-radius: var(--radius-sm);
      white-space: nowrap;
    }

    .header__submenu a:hover {
      background: rgba(248, 250, 252, 0.06);
    }

    .header__submenu li:first-child a {
      font-weight: 600;
    }
  }

  @media (min-width: 861px) and (hover: hover) {
    .header__dropdown:hover .header__submenu {
      display: block;
    }

    .header__dropdown:hover .header__dropdown-toggle svg {
      transform: rotate(180deg);
    }
  }

  /* Mobile: menú colapsado en overlay */
  @media (max-width: 860px) {
    .header__toggle {
      display: inline-flex;
    }

    .header__nav {
      position: fixed;
      inset: 72px 0 0 0;
      background: var(--color-primario);
      flex-direction: column;
      align-items: stretch;
      padding: var(--sp-4) var(--container-pad);
      gap: var(--sp-4);
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition-base), transform var(--transition-base);
      overflow-y: auto;
    }

    .header__nav.is-open {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .header__links {
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-1);
    }

    .header__links a {
      display: block;
      padding: var(--sp-2) 0;
      font-size: var(--fs-md);
      border-bottom: 1px solid rgba(248, 250, 252, 0.08);
    }

    .header__dropdown-toggle {
      width: 100%;
      justify-content: space-between;
      padding: var(--sp-2) 0;
      font-size: var(--fs-md);
      border-bottom: 1px solid rgba(248, 250, 252, 0.08);
    }

    .header__submenu {
      padding-left: var(--sp-2);
    }

    .header__submenu a {
      font-size: var(--fs-base);
    }

    .header__cta {
      width: 100%;
    }
  }

  @media (min-width: 861px) {
    .header__toggle {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-principal');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Submenú "Guías"
  const guiasToggle = document.getElementById('guias-toggle');
  const dropdown = guiasToggle?.closest<HTMLElement>('.header__dropdown');

  if (guiasToggle && dropdown) {
    const setAbierto = (abierto: boolean) => {
      dropdown.classList.toggle('is-open', abierto);
      guiasToggle.setAttribute('aria-expanded', String(abierto));
    };

    guiasToggle.addEventListener('click', () => {
      setAbierto(!dropdown.classList.contains('is-open'));
    });

    // Cerrar al hacer clic afuera, con Escape o al salir con Tab
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node)) setAbierto(false);
    });

    dropdown.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dropdown.classList.contains('is-open')) {
        setAbierto(false);
        guiasToggle.focus();
      }
    });

    dropdown.addEventListener('focusout', (e) => {
      if (!dropdown.contains(e.relatedTarget as Node)) setAbierto(false);
    });
  }
</script>
