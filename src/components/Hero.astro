---
// Hero principal. El mockup del efecto se resuelve con una composición
// CSS/SVG (sin dependencias de imagen) para mantener el hero liviano y
// nítido en cualquier resolución.
//
// Si preferís reemplazarlo por fotografía real, usá <Image> de astro:assets:
//   import { Image } from 'astro:assets';
//   import heroImg from '../assets/[IMG_HERO].jpg';
//   <Image src={heroImg} alt="Sala de reuniones con paredes de vidrio: la pantalla
//     del monitor se ve normal desde adentro y aparece en negro vista desde
//     afuera del vidrio" width={960} height={720} loading="eager" />
// Dimensión recomendada: 1200x900px, formato .jpg/.webp optimizado.

const logosClientes = ['[LOGO_CLIENTE_1]', '[LOGO_CLIENTE_2]', '[LOGO_CLIENTE_3]', '[LOGO_CLIENTE_4]', '[LOGO_CLIENTE_5]'];
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Privacidad visual corporativa</p>
      <h1 class="hero__title">Que nadie lea tus pantallas desde afuera</h1>
      <p class="hero__subtitle">
        Una solución instalada sobre vidrios corporativos que oculta el contenido de los
        monitores a la vista externa, sin alterar la transparencia del espacio ni la
        experiencia de quienes trabajan adentro.
      </p>
      <div class="hero__actions">
        <a href="#contacto" class="btn btn-primary">Solicitar demo o cotización</a>
        <a href="#que-es" class="btn btn-secondary">Ver cómo funciona</a>
      </div>
    </div>

    <div class="hero__visual" role="img" aria-label="Comparación de una sala de reuniones con pared de vidrio: desde adentro la pantalla del monitor se ve con normalidad; desde afuera del vidrio, la misma pantalla aparece completamente en negro, mientras las personas y el mobiliario se siguen viendo con claridad">
      <div class="mockup">
        <div class="mockup__pane mockup__pane--in">
          <span class="mockup__tag">Desde adentro</span>
          <div class="mockup__room">
            <svg class="mockup__monitor" viewBox="0 0 120 90" aria-hidden="true" focusable="false">
              <rect x="4" y="4" width="112" height="70" rx="4" fill="#0f2a3d" stroke="#22d3ee" stroke-width="2"/>
              <rect x="14" y="14" width="92" height="50" rx="2" fill="#134a63"/>
              <rect x="20" y="20" width="50" height="6" rx="2" fill="#22d3ee" opacity="0.85"/>
              <rect x="20" y="32" width="70" height="4" rx="2" fill="#5fd8ec" opacity="0.6"/>
              <rect x="20" y="40" width="60" height="4" rx="2" fill="#5fd8ec" opacity="0.6"/>
              <rect x="20" y="48" width="40" height="4" rx="2" fill="#5fd8ec" opacity="0.6"/>
              <rect x="50" y="74" width="20" height="8" fill="#0f2a3d"/>
              <rect x="40" y="82" width="40" height="4" rx="2" fill="#0f2a3d"/>
            </svg>
            <svg class="mockup__person" viewBox="0 0 40 90" aria-hidden="true" focusable="false">
              <circle cx="20" cy="16" r="10" fill="#94a3b8"/>
              <path d="M4 88c0-16 7-28 16-28s16 12 16 28" fill="#94a3b8"/>
            </svg>
          </div>
        </div>

        <div class="mockup__glass" aria-hidden="true">
          <span class="mockup__glass-label">Vidrio con film</span>
        </div>

        <div class="mockup__pane mockup__pane--out">
          <span class="mockup__tag mockup__tag--dark">Desde afuera</span>
          <div class="mockup__room">
            <svg class="mockup__monitor" viewBox="0 0 120 90" aria-hidden="true" focusable="false">
              <rect x="4" y="4" width="112" height="70" rx="4" fill="#000000" stroke="#1e293b" stroke-width="2"/>
              <rect x="50" y="74" width="20" height="8" fill="#000000"/>
              <rect x="40" y="82" width="40" height="4" rx="2" fill="#000000"/>
            </svg>
            <svg class="mockup__person" viewBox="0 0 40 90" aria-hidden="true" focusable="false">
              <circle cx="20" cy="16" r="10" fill="#94a3b8"/>
              <path d="M4 88c0-16 7-28 16-28s16 12 16 28" fill="#94a3b8"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__trust">
    <div class="container hero__trust-inner">
      <p class="hero__trust-label">Empresas que ya protegen su información</p>
      <ul class="hero__logos">
        {logosClientes.map((logo) => (
          <li class="hero__logo-placeholder">{logo}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-primario) 0%, var(--color-primario-800) 100%);
    color: var(--color-texto-invertido);
  }

  .hero__inner {
    display: grid;
    gap: var(--sp-6);
    padding-top: var(--sp-7);
    padding-bottom: var(--sp-7);
    align-items: center;
  }

  .hero__title {
    font-size: var(--fs-3xl);
    max-width: 16ch;
    margin-bottom: var(--sp-3);
  }

  .hero__subtitle {
    font-size: var(--fs-md);
    color: rgba(248, 250, 252, 0.75);
    max-width: 52ch;
    margin-bottom: var(--sp-4);
    line-height: var(--lh-normal);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .hero__visual {
    justify-self: center;
    width: 100%;
  }

  .mockup {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 0;
    background: rgba(248, 250, 252, 0.04);
    border: 1px solid rgba(248, 250, 252, 0.12);
    border-radius: var(--radius-lg);
    padding: var(--sp-3);
    box-shadow: var(--shadow-lg);
  }

  .mockup__pane {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .mockup__tag {
    align-self: flex-start;
    font-size: var(--fs-sm);
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.15);
    color: var(--color-acento);
  }

  .mockup__tag--dark {
    background: rgba(15, 23, 42, 0.6);
    color: #cbd5e1;
  }

  .mockup__room {
    display: flex;
    align-items: flex-end;
    gap: var(--sp-1);
    padding: var(--sp-2);
    background: rgba(15, 23, 42, 0.5);
    border-radius: var(--radius-md);
    min-height: 130px;
  }

  .mockup__monitor {
    width: 70%;
  }

  .mockup__person {
    width: 22%;
  }

  .mockup__glass {
    position: relative;
    width: 2px;
    margin-inline: var(--sp-2);
    background: linear-gradient(180deg, transparent, rgba(34, 211, 238, 0.7), transparent);
  }

  .mockup__glass-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(90deg);
    white-space: nowrap;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(248, 250, 252, 0.5);
  }

  .hero__trust {
    border-top: 1px solid rgba(248, 250, 252, 0.1);
    background: rgba(0, 0, 0, 0.15);
  }

  .hero__trust-inner {
    padding-block: var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .hero__trust-label {
    font-size: var(--fs-sm);
    color: rgba(248, 250, 252, 0.55);
  }

  .hero__logos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  .hero__logo-placeholder {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: rgba(248, 250, 252, 0.4);
    letter-spacing: 0.02em;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.1fr 1fr;
      padding-top: var(--sp-8);
      padding-bottom: var(--sp-6);
    }
  }
</style>
