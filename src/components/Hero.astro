---
// Hero principal. La columna derecha muestra un video de YouTube embebido
// en loop y con autoplay. Los navegadores solo permiten autoplay si el
// video está silenciado (mute=1), y el loop de YouTube requiere pasar el
// mismo ID en `playlist`.
const VIDEO_ID = 'smGtQfUc254';
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Privacidad visual corporativa</p>
      <h1 class="hero__title">Que nadie vea las pantallas desde afuera</h1>
      <p class="hero__subtitle">
        Oculta las pantallas de la oficina, sin perder la transparencia del vidrio.
        Confidencialidad real, sin cerrar el espacio.
      </p>
      <div class="hero__actions">
        <a href="#contacto" class="btn btn-primary">Solicitar cotización</a>
        <a href="#que-es" class="btn btn-secondary">Ver cómo funciona</a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__video">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${VIDEO_ID}?autoplay=1&mute=1&loop=1&playlist=${VIDEO_ID}&controls=0&playsinline=1&rel=0&modestbranding=1`}
          title="Casper Cloaking Film: la pantalla se ve desde adentro y queda oculta desde afuera del vidrio"
          allow="autoplay; encrypted-media; picture-in-picture"
          referrerpolicy="strict-origin-when-cross-origin"
          loading="eager"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-primario) 0%, var(--color-primario-800) 100%);
    color: var(--color-texto-invertido);
  }

  .hero__inner {
    display: grid;
    gap: var(--sp-6);
    padding-top: var(--sp-7);
    padding-bottom: var(--sp-7);
    align-items: center;
  }

  .hero__title {
    font-size: var(--fs-3xl);
    max-width: 16ch;
    margin-bottom: var(--sp-3);
  }

  .hero__subtitle {
    font-size: var(--fs-md);
    color: rgba(248, 250, 252, 0.75);
    max-width: 52ch;
    margin-bottom: var(--sp-4);
    line-height: var(--lh-normal);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .hero__visual {
    width: 100%;
  }

  .hero__video {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(248, 250, 252, 0.12);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    background: #000;
  }

  .hero__video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr 1.15fr;
      align-items: stretch;
      padding-top: var(--sp-8);
      padding-bottom: var(--sp-8);
    }

    .hero__copy {
      align-self: center;
    }

    /* El video ocupa toda la altura de la columna izquierda. Si la caja no
       es 16:9, el iframe se agranda para cubrirla y se recortan los bordes
       (como object-fit: cover). */
    .hero__video {
      aspect-ratio: auto;
      height: 100%;
      min-height: 320px;
      container-type: size;
    }

    .hero__video iframe {
      inset: auto;
      top: 50%;
      left: 50%;
      width: max(100cqw, 177.78cqh);
      height: max(100cqh, 56.25cqw);
      transform: translate(-50%, -50%);
    }
  }
</style>
