---
// Botón flotante de WhatsApp. Reemplazar [WHATSAPP_NUMERO] por el número
// completo con código de país, sin signos ni espacios (ej: 5491122334455).
const WHATSAPP_NUMERO = '[WHATSAPP_NUMERO]';
const MENSAJE = 'Hola, quiero solicitar una demo sobre la solución de privacidad visual para vidrios corporativos.';
const href = `https://wa.me/${WHATSAPP_NUMERO}?text=${encodeURIComponent(MENSAJE)}`;
---

<a
  href={href}
  class="whatsapp-float"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribinos por WhatsApp (se abre en una pestaña nueva)"
>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.35.63 4.55 1.73 6.44L4 29l7.72-1.68a12.9 12.9 0 0 0 4.3.73h.01c6.62 0 12.02-5.4 12.02-12.02C28.05 8.4 22.65 3 16.02 3zm0 21.96h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-4.58 1 .98-4.46-.24-.37a9.92 9.92 0 0 1-1.52-5.52C5.25 9.38 10.1 4.53 16.02 4.53c2.65 0 5.14 1.03 7.02 2.9a9.86 9.86 0 0 1 2.91 7c0 5.92-4.86 10.76-10.93 10.76v-.01zm5.99-8.08c-.33-.16-1.93-.95-2.23-1.06-.3-.11-.52-.16-.74.16-.22.33-.85 1.06-1.04 1.27-.19.22-.38.24-.71.08-.33-.16-1.38-.51-2.63-1.62-.97-.86-1.63-1.93-1.82-2.25-.19-.33-.02-.5.14-.66.15-.15.33-.38.49-.58.16-.19.22-.33.33-.55.11-.22.05-.41-.03-.58-.08-.16-.74-1.79-1.02-2.45-.27-.65-.54-.56-.74-.57l-.63-.01c-.22 0-.58.08-.88.41-.3.33-1.15 1.12-1.15 2.74s1.18 3.18 1.34 3.4c.16.22 2.33 3.56 5.65 4.99.79.34 1.4.55 1.88.7.79.25 1.51.21 2.08.13.63-.1 1.93-.79 2.2-1.55.27-.76.27-1.42.19-1.55-.08-.14-.3-.22-.63-.38z"
    />
  </svg>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: var(--sp-3);
    bottom: var(--sp-3);
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    box-shadow: var(--shadow-lg);
    animation: whatsapp-in 500ms ease 600ms backwards;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .whatsapp-float:hover {
    transform: scale(1.06);
    box-shadow: 0 28px 56px rgba(15, 23, 42, 0.28);
  }

  @keyframes whatsapp-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      animation: none;
    }
  }

  /* En mobile se despega del borde inferior para no tapar el CTA del form */
  @media (max-width: 640px) {
    .whatsapp-float {
      right: var(--sp-2);
      bottom: var(--sp-2);
      width: 52px;
      height: 52px;
    }
  }
</style>
