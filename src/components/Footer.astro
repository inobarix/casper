---
// Footer discreto. Reemplazar datos de contacto placeholder.
import Logo from './Logo.astro';

const NOMBRE_MARCA = 'Invision';
const anioActual = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <p class="footer__logo"><Logo /></p>
      <p class="footer__tagline">Privacidad visual para oficinas con vidrio.</p>
    </div>

    <ul class="footer__contact">
      <li>
        <a href="mailto:invistalat@gmail.com">invistalat@gmail.com</a>
      </li>
      <li>CABA</li>
    </ul>

    <ul class="footer__links">
      <li><a href="#que-es">Qué es</a></li>
      <li><a href="#beneficios">Beneficios</a></li>
      <li><a href="#casos">Casos</a></li>
      <li><a href="#contacto">Contacto</a></li>
    </ul>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {anioActual} {NOMBRE_MARCA}. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primario);
    color: rgba(248, 250, 252, 0.7);
    padding-block: var(--sp-5) var(--sp-3);
  }

  .footer__inner {
    display: grid;
    gap: var(--sp-4);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid rgba(248, 250, 252, 0.1);
  }

  .footer__logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-texto-invertido);
    margin-bottom: var(--sp-1);
  }

  .footer__tagline {
    font-size: var(--fs-sm);
    max-width: 32ch;
  }

  .footer__contact,
  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    font-size: var(--fs-sm);
  }

  .footer__contact a,
  .footer__links a {
    text-decoration: none;
    color: inherit;
    transition: color var(--transition-base);
  }

  .footer__contact a:hover,
  .footer__links a:hover {
    color: var(--color-acento);
  }

  .footer__bottom {
    padding-top: var(--sp-3);
    font-size: var(--fs-sm);
    color: rgba(248, 250, 252, 0.45);
  }

  @media (min-width: 720px) {
    .footer__inner {
      grid-template-columns: 1.2fr 1fr 1fr;
    }
  }
</style>
