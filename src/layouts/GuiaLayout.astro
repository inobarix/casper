---
// Layout de las páginas de contenido (guía pillar + artículos satélite).
// Arma <head> con SEO, Open Graph y JSON-LD (Article, BreadcrumbList y,
// si hay preguntas, FAQPage), el encabezado oscuro con el H1, el índice
// lateral, la imagen principal, las FAQ, el CTA final y "Seguí leyendo".
// El cuerpo de cada página va por el <slot /> por defecto y el párrafo de
// resumen del encabezado por <slot name="resumen" />.
import '../styles/global.css';
import '../styles/guia.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import { GUIAS } from '../data/guias';

export interface Faq {
  pregunta: string;
  respuesta: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  /** Texto corto para la ruta de navegación (breadcrumb). */
  breadcrumb: string;
  eyebrow?: string;
  fechaPublicacion: string;
  fechaActualizacion: string;
  imagen: string;
  imagenAlt: string;
  imagenCaption?: string;
  indice: { id: string; label: string }[];
  faqs?: Faq[];
  ctaTitulo?: string;
}

const {
  title,
  description,
  h1,
  breadcrumb,
  eyebrow = 'Guía',
  fechaPublicacion,
  fechaActualizacion,
  imagen,
  imagenAlt,
  imagenCaption,
  indice,
  faqs = [],
  ctaTitulo = 'Protegé la información de tus pantallas',
} = Astro.props;

const SITE_URL = Astro.site!.href;
const PAGE_URL = new URL(Astro.url.pathname, Astro.site).href;
const OG_IMAGE = '/[OG_IMAGE].jpg'; // mismo placeholder que el home; recomendado 1200x630px

const fechaVisible = new Date(`${fechaActualizacion}T12:00:00`).toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const indiceCompleto = faqs.length
  ? [...indice, { id: 'preguntas-frecuentes', label: 'Preguntas frecuentes' }]
  : indice;

const normalizar = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const relacionadas = GUIAS.filter((g) => g.path !== normalizar(Astro.url.pathname));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${PAGE_URL}#articulo`,
      headline: h1,
      description,
      image: new URL(imagen, Astro.site).href,
      inLanguage: 'es-AR',
      datePublished: fechaPublicacion,
      dateModified: fechaActualizacion,
      mainEntityOfPage: PAGE_URL,
      author: { '@id': `${SITE_URL}#organizacion` },
      publisher: { '@id': `${SITE_URL}#organizacion` },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}#organizacion`,
      name: 'Invision',
      url: SITE_URL,
      email: 'invistalat@gmail.com',
      telephone: '+54 9 11 3607-1340',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
        { '@type': 'ListItem', position: 2, name: breadcrumb, item: PAGE_URL },
      ],
    },
    // Las mismas preguntas se muestran en la página, así el marcado siempre
    // coincide con el contenido visible.
    ...(faqs.length
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${PAGE_URL}#faq`,
            mainEntity: faqs.map((f) => ({
              '@type': 'Question',
              name: f.pregunta,
              acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={PAGE_URL} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:url" content={PAGE_URL} />
    <meta property="og:locale" content="es_AR" />
    <meta property="article:published_time" content={fechaPublicacion} />
    <meta property="article:modified_time" content={fechaActualizacion} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido principal</a>

    <Header />

    <main id="contenido">
      <article>
        <header class="guia-hero">
          <div class="container guia-hero__inner">
            <nav class="guia-breadcrumb" aria-label="Ruta de navegación">
              <a href="/">Inicio</a>
              <span aria-hidden="true">/</span>
              <span aria-current="page">{breadcrumb}</span>
            </nav>

            <p class="eyebrow">{eyebrow}</p>
            <h1 class="guia-hero__title">{h1}</h1>

            <p class="guia-hero__resumen"><slot name="resumen" /></p>

            <p class="guia-hero__meta">
              Por <strong>Invision</strong> · Última actualización:
              <time datetime={fechaActualizacion}>{fechaVisible}</time>
            </p>
          </div>
        </header>

        <div class="container guia-layout">
          <aside class="guia-indice" aria-labelledby="indice-titulo">
            <p class="guia-indice__titulo" id="indice-titulo">En esta guía</p>
            <ol>
              {indiceCompleto.map((item) => (
                <li><a href={`#${item.id}`}>{item.label}</a></li>
              ))}
            </ol>
          </aside>

          <div class="guia-cuerpo">
            <figure class="guia-figura">
              <img
                src={imagen}
                alt={imagenAlt}
                width="1200"
                height="675"
                loading="eager"
                decoding="async"
              />
              {imagenCaption && <figcaption>{imagenCaption}</figcaption>}
            </figure>

            <slot />

            {faqs.length > 0 && (
              <section id="preguntas-frecuentes" class="guia-seccion">
                <h2>Preguntas frecuentes</h2>
                <div class="guia-faq">
                  {faqs.map((faq) => (
                    <div class="guia-faq__item">
                      <h3>{faq.pregunta}</h3>
                      <p>{faq.respuesta}</p>
                    </div>
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>

        <section class="guia-cta" aria-labelledby="cta-titulo">
          <div class="container guia-cta__inner">
            <h2 id="cta-titulo">{ctaTitulo}</h2>
            <p>
              Si tenés una oficina con vidrios y pantallas a la vista, podemos evaluar tu caso y
              armarte una solución a medida. <a href="/#contacto">Coordiná un diagnóstico</a> sin
              cargo y definimos alcance, plazos y cotización.
            </p>
            <a href="/#contacto" class="btn btn-primary">Coordiná un diagnóstico</a>
          </div>
        </section>
      </article>

      <section class="container guia-relacionadas" aria-labelledby="relacionadas-titulo">
        <h2 id="relacionadas-titulo">Seguí leyendo</h2>
        <ul class="guia-relacionadas__grid">
          {relacionadas.map((g) => (
            <li>
              <a href={g.path} class="guia-relacionadas__card">
                <strong>{g.titulo}</strong>
                <span>{g.resumen}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <Footer />
    <WhatsappFloat />
  </body>
</html>
