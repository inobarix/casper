---
// Guía pillar: privacidad de pantallas en oficinas / visual hacking.
// Pensada para búsquedas informacionales y para ser citada por motores de
// respuesta (definiciones cortas, tabla comparativa y FAQ con schema).
// Enlaza a los artículos satélite y ellos enlazan de vuelta acá.
import GuiaLayout from '../layouts/GuiaLayout.astro';

const indice = [
  { id: 'que-es-visual-hacking', label: 'Qué es el visual hacking' },
  { id: 'donde-esta-el-peligro', label: 'Dónde está el peligro' },
  { id: 'soluciones', label: 'Qué soluciones existen' },
  { id: 'film-de-ocultacion', label: 'Cómo funciona el film de ocultación' },
  { id: 'para-quien-es', label: 'Para quién es' },
  { id: 'instalacion', label: 'Instalación' },
];

const comparativa = [
  {
    solucion: 'Filtro de privacidad en el monitor (ej. 3M)',
    hace: 'Angosta el ángulo de visión de cada pantalla',
    limitacion: 'Hay que ponerlo pantalla por pantalla; molesta al propio usuario en ángulo',
  },
  {
    solucion: 'Smart film / PDLC (vidrio que se opaca con un botón)',
    hace: 'Vuelve el vidrio opaco por completo',
    limitacion: 'Tapa todo el ambiente, no solo la pantalla: perdés la transparencia',
  },
  {
    solucion: 'Cortinas o vinilos esmerilados',
    hace: 'Bloquean la visión del espacio',
    limitacion: 'Cierran el espacio y la luz; poco flexible',
  },
  {
    solucion: 'Film de ocultación de pantallas (tipo Casper)',
    hace: 'Oculta solo las pantallas desde afuera, deja ver el resto',
    limitacion: 'Funciona en pantallas LCD con retroiluminación LED',
    destacada: true,
  },
];

const faqs = [
  {
    pregunta: '¿El film de ocultación sirve en cualquier pantalla?',
    respuesta:
      'Funciona en pantallas LCD con retroiluminación LED, que son la mayoría de los monitores y TVs actuales. En pantallas OLED el efecto no está garantizado, por lo que conviene verificar el tipo de pantalla antes de instalar.',
  },
  {
    pregunta: '¿Se ve mal la pantalla desde adentro?',
    respuesta:
      'No. Desde adentro se ve la pantalla y el ambiente con total normalidad. El efecto de ocultación solo ocurre para quien mira desde el otro lado del vidrio.',
  },
  {
    pregunta: '¿El film opaca todo el vidrio?',
    respuesta:
      'No. A diferencia de un smart film o un vidrio esmerilado, no tapa el ambiente: el vidrio sigue transparente y solo las pantallas se ven negras desde afuera.',
  },
  {
    pregunta: '¿El film daña el vidrio?',
    respuesta:
      'No. Es una lámina autoadhesiva pensada para aplicarse y, llegado el caso, retirarse sin dañar el vidrio.',
  },
  {
    pregunta: '¿Ustedes hacen la instalación?',
    respuesta:
      'Sí. Entregamos la solución instalada, con diagnóstico previo y verificación del efecto. No vendemos solo el material.',
  },
  {
    pregunta: '¿En qué se diferencia de un filtro de privacidad para monitor?',
    respuesta:
